{
  "uid": "rul-service",
  "title": "RUL service health",
  "description": "The prediction service's health, from Prometheus (src/monitoring/metrics.py). Data drift is checked separately: scripts/check_drift.py.",
  "tags": ["rul", "monitoring"],
  "timezone": "browser",
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Service reachable",
      "description": "Can Prometheus read the service's /metrics page? Prometheus records 'up' itself: 1 = its last collection worked, 0 = it failed. If this is DOWN, every other panel is out of date.",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up{job=\"rul-service\"}",
          "legendFormat": "rul-service"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Model answering",
      "description": "Which registered model version the service loaded at start-up (rul_model_info). A promotion shows here after `docker compose restart rul-service`.",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rul_model_info",
          "legendFormat": "{{model_name}} v{{model_version}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "name"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests per second",
      "description": "Prediction requests handled per second, one line per HTTP status (200 = answered, 422 = refused). $__rate_interval: Grafana picks the averaging window -- at least 4x Prometheus's 5 s collection, wider when zoomed out.",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (status) (rate(rul_http_requests_total{route=\"/predict\"}[$__rate_interval]))",
          "legendFormat": "status {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Response time",
      "description": "How long /predict takes to answer: half of requests within the median, 95% within the '95%' line. Worked out from the histogram's buckets, so close estimates.",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(rul_http_request_duration_seconds_bucket{route=\"/predict\"}[$__rate_interval])))",
          "legendFormat": "median"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rul_http_request_duration_seconds_bucket{route=\"/predict\"}[$__rate_interval])))",
          "legendFormat": "95%"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Refused requests (%)",
      "description": "Share of /predict requests refused (422: wrong shape or broken history). 'or vector(0)': before anything was ever refused, the 422 counter does not exist yet -- show 0% instead of 'No data'. With no traffic at all it shows 'No data': 0 of 0 is not 0%.",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (sum(rate(rul_http_requests_total{route=\"/predict\",status=\"422\"}[$__rate_interval])) or vector(0)) / sum(rate(rul_http_requests_total{route=\"/predict\"}[$__rate_interval]))",
          "legendFormat": "refused"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Warnings and diary failures (per minute)",
      "description": "Predictions answered with a warning (a reading outside the training range), and predictions the diary failed to save. Both normally 0. Warnings rising: readings are changing -- run scripts/check_drift.py. Diary failures: monitoring is missing data.",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(rul_predictions_with_warnings_total[$__rate_interval]) * 60",
          "legendFormat": "predictions with warnings"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(rul_prediction_log_failures_total[$__rate_interval]) * 60",
          "legendFormat": "diary failures"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    }
  ]
}
